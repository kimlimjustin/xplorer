{
  "name": "xplorer",
  "version": "0.1.0",
  "description": "Xplorer - A modern, AI-powered file explorer built with Tauri and React",
  "type": "module",
  "license": "AGPL-3.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "frontend:dev": "vite dev",
    "frontend:build": "vite build",
    "frontend:preview": "vite preview",
    "docs": "pnpm --filter docs run start",
    "dev": "concurrently \"pnpm run frontend:dev\" \"pnpm run tauri:dev\" \"pnpm run marketplace:dev\"",
    "dev:app": "concurrently \"pnpm run frontend:dev\" \"pnpm run tauri:dev\"",
    "marketplace:dev": "pnpm --filter xplorer-web run dev 2>/dev/null || echo 'Marketplace not available (clone private submodule first)'",
    "marketplace:db": "docker compose -f private/infra/docker-compose.yml up -d postgres 2>/dev/null || echo 'Private infra not available'",
    "build": "pnpm frontend:build && pnpm tauri:build",
    "tauri": "tauri",
    "tauri:dev": "cd apps && tauri dev",
    "tauri:build": "cd apps && tauri build",
    "check": "tsc",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:tauri": "cd apps/src-tauri && cargo test",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "lint": "eslint apps/client/src/",
    "lint:fix": "eslint --fix apps/client/src/",
    "format": "prettier --write \"apps/client/src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"apps/client/src/**/*.{ts,tsx,css}\"",
    "prepare": "husky"
  },
  "dependencies": {
    "@crabnebula/tauri-plugin-drag": "^2.1.0",
    "@radix-ui/react-checkbox": "^1.1.5",
    "@radix-ui/react-select": "^2.1.7",
    "@tanstack/react-query": "^5.60.5",
    "@tanstack/react-virtual": "^3.13.19",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "clsx": "^2.1.1",
    "diff": "^8.0.3",
    "dompurify": "^3.3.1",
    "i18next": "^25.8.20",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.542.0",
    "mammoth": "^1.9.1",
    "papaparse": "^5.5.3",
    "pdfjs-dist": "^5.3.93",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.5.8",
    "react-pdf": "^10.0.1",
    "react-syntax-highlighter": "^15.6.1",
    "tailwind-merge": "^2.6.0",
    "wouter": "^3.3.5",
    "xlsx": "^0.18.5"
  },
  "lint-staged": {
    "apps/client/src/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix --no-warn-ignored"
    ],
    "apps/client/src/**/*.css": [
      "prettier --write"
    ],
    "e2e/**/*.ts": [
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/typography": "^0.5.15",
    "@tauri-apps/cli": "^2.10.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/diff": "^8.0.0",
    "@types/dompurify": "^3.2.0",
    "@types/node": "20.16.11",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "@vitejs/plugin-react": "^4.3.2",
    "@vitest/coverage-v8": "^2.0.0",
    "@vitest/ui": "^2.0.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "esbuild": "^0.25.0",
    "eslint": "^10.0.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "jsdom": "^25.0.0",
    "lint-staged": "^16.4.0",
    "postcss": "^8.4.47",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.19.1",
    "typescript": "5.6.3",
    "vite": "^5.4.19",
    "vitest": "^2.0.0"
  }
}
