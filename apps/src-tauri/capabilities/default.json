{
  "$schema": "../gen/schemas/capability.json",
  "identifier": "default",
  "description": "Default capabilities for Xplorer",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-emit",
    "core:event:default",
    "core:window:allow-set-title",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "core:window:allow-is-maximized",
    "core:window:allow-set-background-color",
    "core:window:default",
    "core:app:default",
    "core:resources:default",
    "core:menu:default",
    "core:tray:default",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-read-dir",
    "fs:allow-exists",
    "fs:allow-stat",
    "fs:read-all",
    "fs:allow-write-file",
    "fs:allow-create",
    "fs:allow-rename",
    "fs:allow-remove",
    "fs:write-all",
    "dialog:default",
    "global-shortcut:default",
    "drag:default"
  ]
}
